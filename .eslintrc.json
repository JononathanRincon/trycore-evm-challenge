{
  "extends": ["next/core-web-vitals"],
  "ignorePatterns": [".agents/**", "node_modules/**", ".next/**", "dist/**"],
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "no-console": [
      "warn",
      {
        "allow": ["warn", "error", "info"]
      }
    ]
  }
}
