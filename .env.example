# Database connection string (PostgreSQL via Neon / Supabase / Local)
# Connect to Postgres via connection pooler (Transaction mode, port 6543 on Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/trycore_evm?schema=public"

# Direct session connection for Prisma migrations (Session mode, port 5432 on Supabase)
DIRECT_URL="postgresql://user:password@localhost:5432/trycore_evm?schema=public"

# Base URL for API calls / Docs
NEXT_PUBLIC_APP_URL="http://localhost:3000"

